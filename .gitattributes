# Normalize line endings: LF in the repo and in working copies.
# Keeps diffs clean across Windows/macOS/Linux and CI.
* text=auto eol=lf

# Lockfile is generated — collapse it in diffs and PR reviews.
package-lock.json -diff linguist-generated

# Binary assets: never touch, never diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
